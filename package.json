{
  "name": "nalamlink-ai",
  "version": "3.1.0",
  "private": true,
  "description": "Enhanced elderly care coordination platform with visual analytics, cross-record search, CSV reporting, medication intelligence and Supabase-backed deployment.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"npm run server:dev\"",
    "server:dev": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --pretty false",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "dotenv": "^17.2.3",
    "@supabase/supabase-js": "^2.57.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
