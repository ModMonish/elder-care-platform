# Local demo — no cloud account or payment method required
NODE_ENV=development
PORT=8080
TZ=Asia/Kolkata
DEMO_MODE=true
DATA_MODE=demo
OCR_ENABLED=true

# Optional persistent production data + authentication (Supabase Free)
# Create a Supabase project, run supabase/migrations/001_nalamlink_schema.sql,
# then set DATA_MODE=supabase and DEMO_MODE=false.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Backward-compatible key name if your dashboard labels it service_role:
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI via any OpenAI-compatible provider. Mitra has a grounded local fallback.
# Keep the key server-side; never prefix it with VITE_.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional email through Resend HTTPS API (not SMTP; suitable for Render Free)
RESEND_API_KEY=
EMAIL_FROM=

# Optional scheduled dispatch. Configure an external HTTPS cron provider.
CRON_SECRET=
DOSE_GRACE_MINUTES=30
